# RepoPilot Environment Configuration

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_SERVICE_PORT=8000

# Database (PostgreSQL + pgvector)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=repopilot
POSTGRES_USER=repopilot_user
POSTGRES_PASSWORD=change_me

# Redis Cache & Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=hehe

# Security
JWT_SECRET=replace_with_a_randomt_256_bits_long_for_security
JWT_EXPIRATION_MS=86400000

# GitHub Integration
GITHUB_CLIENT_ID=your_github_client_id_placeholder
GITHUB_CLIENT_SECRET=your_github_client_secret_placeholder
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github
GITHUB_ENCRYPTION_KEY=replace_with_a_secure_32_byte_encryption_key

# AI Service & Embedding Configuration
LLM_API_KEY=your_llm_api_key_placeholder
LLM_MODEL=gpt-4o
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=your_voyage_api_key_placeholder
EMBEDDING_MODEL=voyage-code-4
EMBEDDING_DIMENSION=1024
AI_SERVICE_URL=http://ai-service:8000
